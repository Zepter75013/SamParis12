# Copier ce fichier en ".env" (non versionné) et remplir les valeurs réelles.
# Ce sont les identifiants de la NOUVELLE base/utilisateur à créer dans le
# conteneur MySQL existant ("bdd-mysql") pour l'app SAM Paris 12 — pas les
# identifiants des autres apps (Finance, disques) sur ce même conteneur.

SAMPARIS12_DB_NAME=samparis12db
SAMPARIS12_DB_USER=SamParis12Admin
SAMPARIS12_DB_PASSWORD=

# URL publique du frontend (utilisée pour l'en-tête CORS du backend)
FRONTEND_URL=https://samparis12.juliotte-app.fr

# Secret de signature des jetons de session de l'espace adhérent (chaîne aléatoire longue)
JWT_SECRET=

# Liaison Strava (écran « Mon activité ») : identifiant et secret de l'application créée sur https://www.strava.com/settings/api
# (voir docs/strava-installation.md). Laisser vide pour désactiver la liaison.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Notifications push (messages, courses, rappels, documents) : clés VAPID du club, à générer UNE SEULE FOIS avec
#   cd backend && go run ./cmd/vapid
# (changer de clés désabonne tous les appareils). Sans clés, le push est désactivé ; les e-mails de notification
# fonctionnent quand même (ils utilisent le SMTP ci-dessous).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=contact@samparis12.org

# SMTP utilisé pour l'envoi des codes de définition/réinitialisation de mot de passe
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
