# Copier en ".env" (non versionné) et remplir.
MYSQL_ROOT_PASSWORD=
SAMPARIS12_DB_NAME=samparis12db
SAMPARIS12_DB_USER=SamParis12Admin
SAMPARIS12_DB_PASSWORD=

# URL publique du site (en-tête CORS et liens des e-mails)
FRONTEND_URL=https://samparis12.juliotte-app.fr

# Chaîne aléatoire longue : openssl rand -hex 32
JWT_SECRET=

# SMTP pour les e-mails d'invitation et les codes d'accès (reprendre les valeurs du .env du NAS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
